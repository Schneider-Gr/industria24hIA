# Copie para .env.local e preencha. NUNCA commite .env.local (já no .gitignore).
# Valores no painel Supabase: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Contas de demonstração no /login (e-mails + senha em texto no bundle).
# "1" só em preview/staging; ausente em produção — assim a lista e a senha
# nem entram no bundle de prod.
# NEXT_PUBLIC_MOSTRAR_CONTAS_TESTE=1

# service_role NUNCA vai aqui nem no client. Só em edge/functions server-side.
# SUPABASE_SERVICE_ROLE_KEY=

# Sentry (observabilidade). DSN do projeto: sentry.io -> Settings -> Client Keys.
# Sem DSN o SDK fica inativo (no-op) e nada é enviado.
NEXT_PUBLIC_SENTRY_DSN=
# Só no build (Vercel) para upload de source maps + release health (#4).
# SENTRY_ORG=industria24h
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
#
# Ajuste de amostragem (opcional; defaults no código). Baixar em produção:
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1     # #2 tracing client
# SENTRY_TRACES_SAMPLE_RATE=1                 # #2 tracing server/edge
# NEXT_PUBLIC_SENTRY_REPLAY_SESSION_RATE=0.1  # #3 replay de sessões normais
# NEXT_PUBLIC_SENTRY_REPLAY_ERROR_RATE=1      # #3 replay quando há erro

# Resend (e-mail de curadoria de produto para o vendedor).
# Sem a chave, o envio vira no-op e a curadoria segue gravada normalmente.
RESEND_API_KEY=
# RESEND_FROM="Indústria 24h <nao-responda@industria24.com.br>"

# Uber Direct (frete fallback — PRD 008). Painel: direct.uber.com -> Developer.
# Nunca prefixar com NEXT_PUBLIC_: client_secret é segredo server-only.
UBER_DIRECT_CUSTOMER_ID=
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
# Chave de assinatura HMAC dos webhooks. O painel Uber Direct (Webhooks) não
# expõe signing secret próprio — usar o mesmo valor de UBER_DIRECT_CLIENT_SECRET
# (hipótese não confirmada, ver comentário em api/webhooks/uber-direct/route.ts).
# Ausente = validação de assinatura desligada (aceita qualquer request).
UBER_DIRECT_WEBHOOK_SIGNING_KEY=

# Agente "Curadoria de vendedor" hospedado no Fleet (LangSmith). PAT pessoal,
# gerado em smith.langchain.com -> Settings -> API Keys. Sem a chave,
# pedirParecerFleet() só retorna erro, nada mais quebra. Na Vercel a
# integração registrou o nome como LANG_CHAIN_API_KEY (o código aceita os dois).
LANGSMITH_API_KEY=

# Bot de atendimento via WhatsApp (Meta). App Secret do app WhatsApp Business
# no painel Meta Developers — usado só para validar a assinatura HMAC-SHA256
# do header X-Hub-Signature-256 nos webhooks recebidos (Issue #384).
# Ausente = webhook rejeita todo POST (fail-closed, diferente do Uber Direct).
WHATSAPP_APP_SECRET=
