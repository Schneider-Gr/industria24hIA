# Servidor MCP Industria24 — variáveis do SERVIDOR (nunca vão para o parceiro).
SUPABASE_URL=https://tiwdqgyeyvceaiqqwitc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Anon key — usada SÓ pelo tool industria24_finalizar_compra, autenticada com o
# access token do próprio comprador (nunca service_role). Sem isso o módulo
# 'checkout' fica indisponível mesmo se listado em MCP_WRITE_ENABLED.
SUPABASE_ANON_KEY=

# Porta/host do HTTP.
PORT=3333
HOST=0.0.0.0

# Escrita nasce DESABILITADA. Ligue módulo a módulo depois do QA.
# Valores válidos (lista separada por vírgula): catalogo,pedidos,checkout
# Ex: MCP_WRITE_ENABLED=catalogo
MCP_WRITE_ENABLED=

# Opcional: allowlist de Origin para proteção anti DNS-rebinding (separada por vírgula).
# Ex: ALLOWED_HOSTS=mcp.industria24.com.br
ALLOWED_HOSTS=
