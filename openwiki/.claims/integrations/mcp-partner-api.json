    {
      "id": "claim_1b453eb143964c5c9ed834b90cb412da",
      "statement": "Catalogue and order writes constrain the target row to the token's `lojaId`, while delivery updates resolve ownership through delivery, line item, and order before changing the delivery; the exposed write fields exclude financial and moderation data.",
      "evidence": [
        {
          "resource": "repo://mcp-server/src/server.ts#L149-L152",
