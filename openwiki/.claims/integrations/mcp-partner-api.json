    {
      "id": "claim_618557b5a66944828d6b92e63c974ed5",
      "statement": "`industria24_finalizar_compra` is a checkout-gated two-principal flow: it requires a buyer Supabase access token, validates and queries through an anon-key buyer client, groups items per store, invokes `checkout_criar_pedido`, and returns order payment URLs without starting an Asaas charge.",
      "evidence": [
